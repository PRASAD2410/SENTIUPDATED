NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# Never commit the real key. Paste a newly generated Gemini key only into .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FRONTEND_ORIGIN=http://localhost:5173
SPACY_MODEL=en_core_web_sm
# Entities always come from spaCy and identifier rules.
# Use regex for an offline narrative relationship extractor.
RELATIONSHIP_EXTRACTOR=gemini
GEMINI_MAX_RELATIONSHIP_CHUNKS=40
# Send source passages around local entity mentions and batch them together.
# Set false to include all original eligible narrative chunks instead.
GEMINI_COMPACT_CONTEXT=true
# Local development (Docker Compose overrides the URI with its service name).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sentinelgraph
